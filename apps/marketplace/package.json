{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check:boundaries": "node --test scripts/check-vault-boundaries.test.mjs && node scripts/check-vault-boundaries.mjs",
    "format:check": "prettier --check \"src/app/{vault,login,signup,share,invite,api}/**/*.{ts,tsx}\" \"src/components/vault-*.tsx\" src/components/site-header.tsx \"src/lib/{rights-check,vault-*}.ts\" \"tests/{rights-check,vault-store,vault-access}.test.ts\" e2e \"scripts/check-vault-boundaries*.mjs\" playwright.config.ts vitest.config.ts next.config.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
